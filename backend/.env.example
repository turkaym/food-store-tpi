# PostgreSQL connection used by the intended local setup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# Replace this example before using the application outside local evaluation.
SECRET_KEY=replace-with-a-private-secret-of-at-least-32-characters

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
